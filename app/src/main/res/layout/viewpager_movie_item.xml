<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Conteneur principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Logo cinéma en haut -->
        <ImageView
            android:id="@+id/cinemaLogo"
            android:layout_width="120dp"
            android:layout_height="100dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp" />

        <!-- Titre du film en cursive -->
        <TextView
            android:id="@+id/movieTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deadpool &amp; Wolverine"
            android:textColor="#999999"
            android:textSize="20sp"
            android:fontFamily="cursive"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="20dp" />

        <!-- Conteneur du cadre avec boutons intégrés -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="20dp">

            <!-- FrameLayout pour le cadre de pellicule + image -->
            <FrameLayout
                android:id="@+id/filmFrameContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Cadre de pellicule (bandes noires avec perforations) -->
                <ImageView
                    android:id="@+id/filmFrame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:background="@color/black"
                    android:scaleType="fitXY" />

                <!-- Image du film (poster) à l'intérieur du cadre -->
                <ImageView
                    android:id="@+id/moviePoster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="50dp"
                    android:layout_marginRight="50dp"
                    android:layout_marginTop="35dp"
                    android:layout_marginBottom="35dp"
                    android:scaleType="centerCrop"
                    android:background="@color/black"
                    android:contentDescription="Affiche du film" />

            </FrameLayout>

            <!-- Bouton PRÉCÉDENT (gauche) -->
            <TextView
                android:id="@+id/btnPrevious"
                android:layout_width="45dp"
                android:layout_height="420dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:text="◄◄"
                android:textColor="#fff"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#000"
                android:clickable="true"
                android:focusable="true"
                android:elevation="4dp" />

            <!-- Bouton SUIVANT (droite) -->
            <TextView
                android:id="@+id/btnNext"
                android:layout_width="45dp"
                android:layout_height="420dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="1dp"
                android:background="#000"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:text="►►"
                android:textColor="#fff"
                android:textSize="24sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Score IMDB en bas -->
        <TextView
            android:id="@+id/scoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IMDB Score: 7.73"
            android:textColor="#999999"
            android:textSize="18sp"
            android:fontFamily="cursive"
            android:gravity="center" />

    </LinearLayout>

</RelativeLayout>