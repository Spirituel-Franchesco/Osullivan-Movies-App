<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fond noir (la pellicule) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Bande blanche gauche (perforations simulées) -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="30dp"
        android:bottom="30dp">
        <shape android:shape="rectangle">
            <stroke android:width="50dp" android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Zone centrale transparente pour le film -->
    <item
        android:left="50dp"
        android:right="50dp"
        android:top="30dp"
        android:bottom="30dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>

</layer-list>